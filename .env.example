# BusinessFlow — environment variable NAMES only (NFR-S1). Copy to .env and set local values.
# Do not commit .env. Never put secret values in artifacts or Prompt Trace.

# --- Runtime adapter (adapter-registry) ---
AAMAD_TARGET_RUNTIME=crewai

# --- Currency (ADR-14): USD or BRL only ---
CURRENCY_CODE=USD

# --- Database (Compose db service + API) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DATABASE_URL=

# --- Auth / session (FR-AUTH, DEC-09) ---
SECRET_KEY=
# Optional single-owner bootstrap names (values set only in local .env)
AUTH_USERNAME=
AUTH_PASSWORD=

# --- LLM provider (copilot / CrewAI) ---
OPENAI_API_KEY=
# Optional org gateway override (leave empty if using default OpenAI endpoint)
OPENAI_API_BASE=
# Optional model pin for CrewAI agents (implementation may read this)
LLM_MODEL=

# --- API / CORS (local Week 3) ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional: same value as SECRET_KEY when backend auth is enabled (local MVP only).
VITE_API_BEARER_TOKEN=
# Force mock fixtures even if VITE_API_BASE_URL is set (true/false).
VITE_USE_MOCK=
# Display currency for UI symbol (ADR-14); mirror CURRENCY_CODE. USD or BRL.
VITE_CURRENCY_CODE=USD

# --- CrewAI storage (adapter-crewai; memory=false for MVP, path reserved) ---
CREWAI_STORAGE_DIR=

# --- Copilot wall-clock (SAD NFR-P4 / SAD-Q2; seconds) ---
COPILOT_TIMEOUT_SECONDS=60

# --- External REST (Sprint 4 — Open Food Facts; no API key required) ---
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
